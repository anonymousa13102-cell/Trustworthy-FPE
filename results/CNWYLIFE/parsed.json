      "procedure_division": {
        "functions": {
          "100-MAIN": {
            "kind": "paragraph",
            "blocks": [
              {
                "Move Statement": "MOVE \"F\" TO end-of-file-flag"
              },
              {
                "Open Statement": "OPEN INPUT initial-condx-file"
              },
              {
                "Perform-Unsupported": "PERFORM 110-INITIALIZE VARYING row-counter FROM 1 BY 1 UNTIL row-counter IS GREATER THAN max-rows"
              },
              {
                "Close Statement": "CLOSE initial-condx-file"
              },
              {
                "Perform-Unsupported": "PERFORM VARYING generation FROM 1 BY 1 UNTIL generation IS GREATER THAN max-gen PERFORM 120-DISP-GEN PERFORM 130-CONWAY-ALG END-PERFORM"
              },
              {
                "Stop Statement": "STOP RUN"
              }
            ]
          },
          "110-INITIALIZE": {
            "kind": "paragraph",
            "blocks": [
              {
                "Read Statement": "READ initial-condx-file AT END MOVE \"T\" TO end-of-file-flag END-READ"
              },
              {
                "Move Statement": "MOVE initial-condx-record to pg-row ( row-counter )"
              }
            ]
          },
          "120-DISP-GEN": {
            "kind": "paragraph",
            "blocks": [
              {
                "Display": "\"Generation: \" generation"
              },
              {
                "Perform-Unsupported": "PERFORM VARYING row-counter FROM 1 BY 1 UNTIL row-counter IS GREATER THAN max-rows DISPLAY pg-row ( row-counter ) END-PERFORM"
              },
              {
                "Display": "SPACES"
              }
            ]
          },
          "130-CONWAY-ALG": {
            "kind": "paragraph",
            "blocks": [
              {
                "Move Statement": "MOVE previous-generation to next-generation"
              },
              {
                "Perform-Unsupported": "PERFORM VARYING row-counter FROM 2 BY 1 UNTIL row-counter IS EQUAL TO max-rows PERFORM VARYING column-counter FROM 2 BY 1 UNTIL column-counter IS EQUAL TO max-columns MOVE ZERO TO neighbor-counter * * EVALUATE pg-column ( row-counter , column-counter ) WHEN living-cell PERFORM 210-LIVING-CELL-NEIGHBORS WHEN dead-cell PERFORM 220-DEAD-CELL-NEIGHBORS END-EVALUATE END-PERFORM END-PERFORM"
              },
              {
                "Move Statement": "MOVE next-generation TO previous-generation"
              }
            ]
          },
          "200-COUNT-LIVING-NEIGHBORS": {
            "kind": "paragraph",
            "blocks": [
              {
                "Perform-Unsupported": "PERFORM VARYING y FROM - 1 BY 1 UNTIL y IS GREATER THAN 1 PERFORM VARYING x FROM - 1 BY 1 UNTIL x IS GREATER THAN 1 * * * * * * IF x IS NOT EQUAL TO ZERO OR y IS NOT EQUAL TO ZERO THEN ADD y TO row-counter GIVING neighbor-y ADD x to column-counter GIVING neighbor-x IF pg-column ( neighbor-y , neighbor-x ) IS EQUAL TO living-cell THEN ADD 1 TO neighbor-counter END-IF END-IF END-PERFORM END-PERFORM"
              }
            ]
          },
          "210-LIVING-CELL-NEIGHBORS": {
            "kind": "paragraph",
            "blocks": [
              {
                "Perform": "200-COUNT-LIVING-NEIGHBORS"
              },
              {
                "Evaluate-block": {
                  "subjects": [
                    "TRUE"
                  ],
                  "branches": [
                    {
                      "kind": "when",
                      "statements": [
                        {
                          "Move Statement": "MOVE living-cell TO ng-column ( row-counter , column-counter )"
                        }
                      ],
                      "objects": [
                        "( neighbor-counter = 2 ) OR ( neighbor-counter = 3 )"
                      ]
                    },
                    {
                      "kind": "when-other",
                      "statements": [
                        {
                          "Move Statement": "MOVE dead-cell TO ng-column ( row-counter , column-counter )"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "220-DEAD-CELL-NEIGHBORS": {
            "kind": "paragraph",
            "blocks": [
              {
                "Perform": "200-COUNT-LIVING-NEIGHBORS"
              },
              {
                "Evaluate-block": {
                  "subjects": [
                    "TRUE"
                  ],
                  "branches": [
                    {
                      "kind": "when",
                      "statements": [
                        {
                          "Move Statement": "MOVE living-cell TO ng-column ( row-counter , column-counter )"
                        }
                      ],
                      "objects": [
                        "neighbor-counter = 3"
                      ]
                    },
                    {
                      "kind": "when-other",
                      "statements": [
                        {
                          "Move Statement": "MOVE dead-cell TO ng-column ( row-counter , column-counter )"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "blocks": []
      }
