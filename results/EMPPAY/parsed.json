      "procedure_division": {
        "functions": {
          "INITIALIZATION": {
            "kind": "paragraph",
            "blocks": [
              {
                "Move Statement": "MOVE \"Millard\" TO EMP-FNAME"
              },
              {
                "Move Statement": "MOVE \"Fillmore\" TO EMP-LNAME"
              },
              {
                "Move Statement": "MOVE 19 TO EMP-HOURS"
              },
              {
                "Move Statement": "MOVE 23.50 TO EMP-HOURLY-RATE"
              }
            ]
          },
          "PAYMENT-WEEKLY": {
            "kind": "paragraph",
            "blocks": [
              {
                "If-block": {
                  "condition": "EMP-HOURS >= 40",
                  "then": [
                    {
                      "Move Statement": "MOVE .25 TO EMP-OT-RATE"
                    }
                  ],
                  "else-if": [
                    {
                      "condition": "EMP-HOURS >= 50",
                      "then": [
                        {
                          "Move Statement": "MOVE .50 TO EMP-OT-RATE"
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "Move Statement": "MOVE ZERO TO EMP-OT-RATE"
                    }
                  ]
                }
              },
              {
                "Compute Statement": "COMPUTE EMP-PAY-WEEK = ( EMP-HOURS * EMP-HOURLY-RATE ) * ( 1 + EMP-OT-RATE )"
              }
            ]
          },
          "PAYMENT-MONTHLY": {
            "kind": "paragraph",
            "blocks": [
              {
                "If-block": {
                  "condition": "EMP-HOURS > 150",
                  "then": [
                    {
                      "Move Statement": "MOVE .50 TO EMP-REWARD"
                    }
                  ],
                  "else": [
                    {
                      "Move Statement": "MOVE ZERO TO EMP-REWARD"
                    }
                  ]
                }
              },
              {
                "Compute Statement": "COMPUTE EMP-PAY-MONTH = ( EMP-PAY-WEEK * 4 ) * ( 1 + EMP-REWARD )"
              }
            ]
          },
          "SHOW-OUTPUT": {
            "kind": "paragraph",
            "blocks": [
              {
                "Display": "\"Name: \" EMP-NAME"
              },
              {
                "Display": "\"Hours Worked Per Week: \" EMP-HOURS"
              },
              {
                "Display": "\"Hourly Rate: \" EMP-HOURLY-RATE"
              },
              {
                "Display": "\"Bonus-Rate: \" EMP-OT-RATE"
              },
              {
                "Display": "\"Gross Pay Per Week: \" EMP-PAY-WEEK"
              },
              {
                "Display": "\"Gross Pay Per Month: \" EMP-PAY-MONTH"
              },
              {
                "Display": "\"Hi Chris - how's Loretta today?\""
              }
            ]
          }
        },
        "blocks": [
          {
            "Perform": "INITIALIZATION"
          },
          {
            "Perform": "PAYMENT-WEEKLY"
          },
          {
            "Perform": "PAYMENT-MONTHLY"
          },
          {
            "Perform": "SHOW-OUTPUT"
          },
          {
            "Stop Statement": "STOP RUN"
          }
        ]
