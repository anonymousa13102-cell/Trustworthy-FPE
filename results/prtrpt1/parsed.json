      "procedure_division": {
        "functions": {
          "0000-Mainline": {
            "kind": "paragraph",
            "blocks": [
              {
                "Perform": "1000-Begin-Job"
              },
              {
                "Perform": "2000-Process"
              },
              {
                "Perform": "3000-End-Job"
              },
              {
                "Stop Statement": "STOP RUN"
              }
            ]
          },
          "1000-Begin-Job": {
            "kind": "paragraph",
            "blocks": [
              {
                "Perform": "1010-Open-Report"
              },
              {
                "Perform": "1020-Open-Member-File"
              },
              {
                "Perform": "6100-Print-Page-Headings"
              },
              {
                "Perform": "5000-Read-Member-File"
              }
            ]
          },
          "1010-Open-Report": {
            "kind": "paragraph",
            "blocks": [
              {
                "Open Statement": "OPEN OUTPUT MembershipReport"
              },
              {
                "Evaluate-block": {
                  "subjects": [
                    "TRUE"
                  ],
                  "branches": [
                    {
                      "kind": "when",
                      "statements": [
                        {
                          "Continue Statement": "CONTINUE"
                        }
                      ],
                      "objects": [
                        "WS-Report-Good"
                      ]
                    },
                    {
                      "kind": "when-other",
                      "statements": [
                        {
                          "Move Statement": "MOVE \"1010\" TO Abn-Paragraph"
                        },
                        {
                          "Move Statement": "MOVE WS-Report-Status TO Abn-Code"
                        },
                        {
                          "Perform": "9000-Abnormal-End"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "1020-Open-Member-File": {
            "kind": "paragraph",
            "blocks": [
              {
                "Open Statement": "OPEN INPUT MemberFile"
              },
              {
                "Evaluate-block": {
                  "subjects": [
                    "TRUE"
                  ],
                  "branches": [
                    {
                      "kind": "when",
                      "statements": [
                        {
                          "Continue Statement": "CONTINUE"
                        }
                      ],
                      "objects": [
                        "WS-Member-Good"
                      ]
                    },
                    {
                      "kind": "when-other",
                      "statements": [
                        {
                          "Move Statement": "MOVE \"1020\" TO Abn-Paragraph"
                        },
                        {
                          "Move Statement": "MOVE WS-Member-Status TO Abn-Code"
                        },
                        {
                          "Perform": "9000-Abnormal-End"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "2000-Process": {
            "kind": "paragraph",
            "blocks": [
              {
                "Perform-Unsupported": "PERFORM 6200-Print-Report-Body UNTIL WS-Member-EOF"
              }
            ]
          },
          "3000-End-Job": {
            "kind": "paragraph",
            "blocks": [
              {
                "Write Statement": "WRITE PrintLine FROM ReportFooting AFTER ADVANCING 5 LINES"
              },
              {
                "Close Statement": "CLOSE MemberFile MembershipReport"
              }
            ]
          },
          "5000-Read-Member-File": {
            "kind": "paragraph",
            "blocks": [
              {
                "Read Statement": "READ MemberFile AT END SET WS-Member-EOF TO TRUE END-READ"
              },
              {
                "Evaluate-block": {
                  "subjects": [
                    "TRUE"
                  ],
                  "branches": [
                    {
                      "kind": "when",
                      "statements": [
                        {
                          "Continue Statement": "CONTINUE"
                        }
                      ],
                      "objects": [
                        "WS-Member-Okay"
                      ]
                    },
                    {
                      "kind": "when-other",
                      "statements": [
                        {
                          "Move Statement": "MOVE \"5000\" TO Abn-Paragraph"
                        },
                        {
                          "Move Statement": "MOVE WS-Member-Status TO Abn-Code"
                        },
                        {
                          "Perform": "9000-Abnormal-End"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "6100-Print-Page-Headings": {
            "kind": "paragraph",
            "blocks": [
              {
                "Write Statement": "WRITE PrintLine FROM PageHeading AFTER ADVANCING PAGE"
              },
              {
                "Write Statement": "WRITE PrintLine FROM ColumnHeadings AFTER ADVANCING 2 LINES"
              },
              {
                "Move Statement": "MOVE 3 TO LineCount"
              },
              {
                "Add Statement": "ADD 1 TO PageCount"
              }
            ]
          },
          "6200-Print-Report-Body": {
            "kind": "paragraph",
            "blocks": [
              {
                "If-block": {
                  "condition": "NewPageRequired",
                  "then": [
                    {
                      "Move Statement": "MOVE PageCount TO PrnPageNum"
                    },
                    {
                      "Write Statement": "WRITE PrintLine FROM PageFooting AFTER ADVANCING 5 LINES"
                    },
                    {
                      "Perform": "6100-Print-Page-Headings"
                    }
                  ]
                }
              },
              {
                "Move Statement": "MOVE MemberId TO PrnMemberId"
              },
              {
                "Move Statement": "MOVE MemberName TO PrnMemberName"
              },
              {
                "Move Statement": "MOVE MemberType TO PrnMemberType"
              },
              {
                "Move Statement": "MOVE MemberGender TO PrnMemberGender"
              },
              {
                "Write Statement": "WRITE PrintLine FROM MemberDetailLine AFTER ADVANCING 1 LINE"
              },
              {
                "Add Statement": "ADD 1 TO LineCount"
              },
              {
                "Perform": "5000-Read-Member-File"
              }
            ]
          },
          "9000-Abnormal-End": {
            "kind": "paragraph",
            "blocks": [
              {
                "Write Statement": "WRITE PrintLine FROM Abnormal-Line AFTER ADVANCING PAGE"
              },
              {
                "Close Statement": "CLOSE MemberFile MembershipReport"
              },
              {
                "Stop Statement": "STOP RUN"
              }
            ]
          }
        },
        "blocks": []
      }
    }
